# npm toolchain (Tailwind CLI + @fontsource); restored via `npm ci`.
/node_modules/

# Generated by `npm run build:css` (Tailwind) before `dx build`; not committed.
/assets/tailwind.css

# Build-time embedded data (see build.rs) produced by update-repos, cargo-about
# and the resume generator; substituted with empty defaults when absent.
# `generated/` also holds the resume PDFs (`generated/resume/*.pdf`) and the
# third-party licence inventory (`generated/licenses.json`) embedded into the
# binary.
/repos.json
/generated/

# dx bundle output.
/dist/
