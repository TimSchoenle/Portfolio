# ---------- Defaults ----------
# Normalize everything Git considers text to LF in the repository; the
# checked-out line ending is decided per pattern below.
* text=auto eol=lf working-tree-encoding=UTF-8

# ---------- Rust workspace ----------
*.rs      text eol=lf diff=rust
Cargo.toml text eol=lf
# Committed on purpose (this workspace ships binaries, not a library), but
# it is machine-rewritten by `cargo` and not meant to be reviewed line by
# line.
Cargo.lock text eol=lf linguist-generated -diff merge=union

# ---------- Configuration & structured data ----------
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
config.example.toml text eol=lf linguist-generated
docs/config.contract.json text eol=lf linguist-generated -diff

# ---------- Docs & prose ----------
*.md text eol=lf diff=markdown
CHANGELOG.md text eol=lf linguist-generated -diff
docs/**      linguist-documentation
LICENSE      text eol=lf linguist-documentation
**/LICENSE*  text eol=lf linguist-documentation

# ---------- Templates ----------
# Handlebars sources rendered by the `update-files` workflow into README.md
# and config.example.toml.
*.hbs text eol=lf linguist-language=Handlebars

# ---------- Web assets ----------
*.css text eol=lf
*.mjs text eol=lf
*.svg text eol=lf

# ---------- Fonts (vendored, binary) ----------
*.ttf   binary linguist-vendored
*.woff2 binary linguist-vendored
apps/resume-generator/fonts/** linguist-vendored
apps/web/assets/fonts/**       linguist-vendored

# ---------- Other binary/media ----------
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary

# ---------- JS lockfile (Tailwind toolchain only) ----------
apps/web/package-lock.json text eol=lf linguist-generated -diff

# ---------- Release automation ----------
.release-please-manifest.json text eol=lf linguist-generated -diff

# ---------- git-archive exports ----------
# `git archive` output is a source snapshot, not a development checkout.
.github/**      export-ignore
.idea/**        export-ignore
.claude/**      export-ignore
.serena/**      export-ignore
.junie/**       export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.dockerignore   export-ignore
CONTRIBUTING.md export-ignore
