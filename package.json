{
  "name": "portfolio",
  "version": "1.15.2",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun run build:prepare && next build --webpack",
    "build:prepare": "bun run build:resume",
    "build:resume": "bun scripts/generate-resumes.ts",
    "build:ci": "NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN= NEXT_PUBLIC_SENTRY_DSN= bun run build",
    "dev": "bun run build:prepare && next dev  --webpack",
    "docker:build": "docker build -t portfolio:latest .",
    "docker:prod": "docker-compose up app",
    "docker:run": "docker run -p 3000:3000 portfolio:latest",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yaml,yml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "knip",
    "lint:deps:fix": "knip --fix",
    "lint:secrets": "gitleaks detect --redact --report-format json --report-path secrets-report.json",
    "license-check": "bun scripts/check-licenses.ts",
    "dep-cruise": "depcruise src --include-only \"src\" --config .dependency-cruiser.js --output-type err-long",
    "start": "PORT=3000 HOSTNAME=0.0.0.0 NODE_ENV=production bun scripts/start-standalone.ts",
    "type-check": "tsc --noEmit",
    "i18n-check": "i18n-check --unused src/ -f next-intl --source en --locales messages || echo \"::warning::i18n-check found issues (non-blocking)\"",
    "analyze": "NEXT_IGNORE_TURBOPACK=true ANALYZE=true next build --webpack",
    "audit": "bun run build:ci && lhci autorun",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=dot",
    "sbom": "cdxgen -o sbom.xml",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "latest",
    "@sentry/nextjs": "^10.32.1",
    "@serwist/next": "9.5.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "latest",
    "lucide-react": "0.564.0",
    "next": "16.1.6",
    "next-intl": "latest",
    "pino": "^10.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@commitlint/types": "latest",
    "@cyclonedx/cdxgen": "12.1.0",
    "@fast-check/vitest": "0.2.4",
    "@lhci/cli": "0.15.1",
    "@lingual/i18n-check": "latest",
    "@next/bundle-analyzer": "16.1.6",
    "@next/eslint-plugin-next": "16.1.6",
    "@playwright/test": "1.58.2",
    "@react-pdf/renderer": "4.3.2",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.2.3",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/webpack": "5.28.5",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "17.3.8",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-secrets": "2.2.2",
    "eslint-plugin-no-unsanitized": "4.1.4",
    "eslint-plugin-perfectionist": "5.5.0",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "3.0.7",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "17.3.0",
    "happy-dom": "20.6.1",
    "husky": "9.1.7",
    "jsdom": "28.0.0",
    "knip": "5.83.1",
    "license-checker-rseidelsohn": "4.4.2",
    "lint-staged": "16.2.7",
    "node-forge": "1.3.3",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "serwist": "9.5.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18",
    "web-vitals": "5.1.0"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Edge versions",
      "Safari >= 16.4",
      "iOS >= 16.4",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nextBundleAnalysis": {
    "showDetails": true,
    "buildOutputDirectory": ".next",
    "budget": 358400,
    "budgetPercentIncreaseRed": 10,
    "minimumChangeThreshold": 500,
    "alwaysShowGzipDiff": true,
    "skipCommentIfEmpty": false
  },
  "workspaces": [
    "."
  ]
}
