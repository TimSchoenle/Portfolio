# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
# Workspace build artifacts (single shared target dir at the repo root).
/target/

# Cargo.lock IS committed on purpose: this workspace ships applications
# (the `web` wasm client + native SSR server, `resume-generator`), so a locked
# dependency graph is required for reproducible builds and `cargo audit`.
# Do NOT add Cargo.lock here.

# rustfmt backups and debug symbols
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# dx / Dioxus web build
# ---------------------------------------------------------------------------
# dx bundle output (apps/web/dist and the shared target/dx/) — also holds the
# generated resume PDFs and resume-fingerprint.json from the resume-generator.
dist/

# Note: apps/web/repos.json is generated by the `update-repos` workflow and
# embedded by apps/web/build.rs; it is intentionally tracked (not ignored).

# ---------------------------------------------------------------------------
# Node (Tailwind CSS tooling only)
# ---------------------------------------------------------------------------
node_modules/

# The build uses `npm ci` against the committed package-lock.json; other
# package managers' lockfiles are not used.
yarn.lock
pnpm-lock.yaml
bun.lockb
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------------------------------------------------------------------------
# Local agent / tooling state
# ---------------------------------------------------------------------------
.claude/
.serena/

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
